# --- Environnements virtuels -------------------------------------------
# Deux venv incompatibles, recreables depuis requirements*.txt
venv/
venv_hunyuan/
__pycache__/
*.pyc

# --- Poids de modeles --------------------------------------------------
# ~2,2 Go, retelechargeables : hf download tencent/HunyuanOCR
HunyuanOCR/

# --- Archive -----------------------------------------------------------
# Ce qui n'est plus utilise mais qu'on ne jette pas : scripts remplaces,
# premiers tests, poids du modele HunyuanOCR (ecarte pour sa licence, qui
# exclut l'UE). Rien la-dedans n'est necessaire pour rejouer le protocole ;
# voir archive/README.md pour le detail et la commande de suppression.
archive/

# --- Corpus exporte ----------------------------------------------------
# dataset/manifest.json EST versionne (227 Ko, c'est l'index utile).
# La copie materialisee des images, elle, se regenere :
#     python dataset/build_manifest.py --export corpus --zip
dataset/corpus/
dataset/corpus.zip
handwriting_specimens_vi_en.zip

# --- Datasets volumineux -----------------------------------------------
TabRecSet/
data/TabRecSet/

# --- Sorties de benchmark ----------------------------------------------
# Regenerables en relancant scripts/bench_deformed.py.
# Les rapports report.html font 17 a 24 Mo piece (images en base64) et les
# sous-dossiers pages/ contiennent les images pretraitees des modeles :
# aucun interet a les versionner, ils gonfleraient le depot pour rien.
results/*/pages/
results/*/report.html
results/_premiers_tests/
results/smoke_hunyuan.md

# On GARDE en revanche les livrables legers et interessants a relire :
#   results/*/merge_report.html        decisions de fusion
#   results/*/demo_fusion_invoice*.html demonstration commentee
# (3 a 4 Mo, acceptable, et ce sont eux qu'on montre)

# --- Residus de l'ancienne arborescence --------------------------------
# Produits par des runs lances avant la reorganisation, quand les sorties
# atterrissaient a la racine. Redondants avec results/ -> a supprimer.
output_*/
benchmark_report_*.html

# --- Divers ------------------------------------------------------------
.DS_Store
Thumbs.db
*.log

# Sonde de plafond : environnement et poids du modele, jamais versionnes.
# FastSAM-s.pt fait 23 Mo et se retelecharge tout seul au premier appel.
venv_sam/
FastSAM-s.pt
*.pt

# Archives des etudes de degradation : 195 a 252 Mo, au-dela de la limite
# GitHub. Le bruit sur des PNG de 1654x2339 est incompressible, d'ou la
# taille. Se regenerent avec :
#   python scripts/degrader.py --jeu variants_warped --zip
#   python scripts/degrader.py --images-dir handwriting/generated --n 3 \
#       --out ../doc3D-renderer/img/handwriting_vi_degradation
kaggle/images_degradation.zip
kaggle/images_handwriting_vi_degradation.zip
kaggle/images_handwriting_en_degradation.zip
kaggle/images_handwriting_vi_warped.zip
kaggle/images_handwriting_en_warped.zip
